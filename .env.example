# Copy this file to .env and fill in the values.

# --- Database ---
# SQLite for local development. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your database.
DATABASE_URL="file:./dev.db"

# --- Auth (next-auth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (for local dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only accounts from this domain may sign in / get an account.
ALLOWED_EMAIL_DOMAIN="match-trade.com"

# Comma-separated list of emails that are always promoted to ADMIN on sign-in.
# (Additionally, the very first user ever to sign in becomes an admin.)
ADMIN_EMAILS=""

# --- App ---
# IANA timezone the office operates in. All "today"/booking-window logic uses it.
OFFICE_TIMEZONE="Europe/Warsaw"

# DANGER: development-only fake login (email/password-less). Never enable in
# production. Allows signing in as any @ALLOWED_EMAIL_DOMAIN address.
AUTH_DEV_LOGIN="false"
