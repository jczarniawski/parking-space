// Prisma schema for the office parking booking app.
//
// Local development uses SQLite. For production, change `provider` to
// "postgresql" and set DATABASE_URL accordingly — the schema is compatible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles:
//  EMPLOYEE   – can book/cancel spots for themselves
//  MANAGEMENT – has a personally assigned (prebooked) spot; can release/reclaim it
//  ADMIN      – configures spots, manages users, sees all bookings and the audit log
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("EMPLOYEE") // EMPLOYEE | MANAGEMENT | ADMIN
  createdAt DateTime @default(now())

  bookings   Booking[]
  ownedSpots ParkingSpot[]
  releases   SpotRelease[]
}

model ParkingSpot {
  id       String  @id @default(cuid())
  number   String  @unique // spot label, e.g. "12" or "A3"
  isActive Boolean @default(true)

  // When set, the spot belongs to a management member and is automatically
  // prebooked for them on the weekdays listed in `prebookDays`.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Comma-separated ISO weekday numbers (1=Mon … 7=Sun) on which the spot is
  // prebooked for its owner. Ignored when ownerId is null. Default: Mon–Fri.
  prebookDays String @default("1,2,3,4,5")

  createdAt DateTime @default(now())

  bookings Booking[]
  releases SpotRelease[]
}

// A booking of one spot by one user for one office-local calendar day.
// Rows are kept after the day passes (that is the admin's history view);
// cancelled bookings are deleted and the cancellation is audit-logged.
model Booking {
  id     String @id @default(cuid())
  date   String // office-local calendar day, "YYYY-MM-DD"
  spotId String
  userId String

  spot ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Race-safety: the database is the final arbiter — one booking per spot per
  // day, and one booking per user per day.
  @@unique([spotId, date])
  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

// A management member releasing their prebooked spot for one day,
// making it bookable by everyone else.
model SpotRelease {
  id           String @id @default(cuid())
  date         String // "YYYY-MM-DD"
  spotId       String
  releasedById String

  spot       ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  releasedBy User        @relation(fields: [releasedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([spotId, date])
  @@index([date])
}

// Immutable trail of everything that happened — bookings, cancellations,
// releases, spot/user administration. This is where admins see actions that
// no longer exist as rows (e.g. cancelled bookings).
model AuditLog {
  id     String  @id @default(cuid())
  action String // BOOKING_CREATED | BOOKING_CANCELLED | SPOT_RELEASED | SPOT_RECLAIMED | SPOTS_CREATED | SPOT_UPDATED | SPOT_DELETED | ROLE_CHANGED | USER_PREPROVISIONED

  actorEmail  String? // who did it
  targetEmail String? // whose booking/role was affected (if different)
  spotNumber  String?
  date        String? // affected booking date, "YYYY-MM-DD"
  details     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
